<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="steam_network_dynamic_dns_title">动态 DNS 加速</string>
    <string name="steam_network_dynamic_dns_description">选择解析来源后，Steam API、商店、社区、聊天、媒体与 CDN 域名会在请求时动态解析，不需要先扫描并固定 IP。</string>
    <string name="steam_network_dynamic_dns_active">已启用 %1$d 个解析来源</string>
    <string name="steam_network_dynamic_dns_system_only">仅使用系统 DNS</string>
    <string name="steam_network_dynamic_dns_no_sources">当前没有启用任何解析来源</string>
    <string name="steam_network_dynamic_dns_disabled">动态 DNS 已关闭</string>
    <string name="steam_network_dynamic_dns_cache_title">本地 DNS 缓存</string>
    <string name="steam_network_dynamic_dns_cache_count">当前缓存 %1$d 个 Steam 域名</string>
    <string name="steam_network_dynamic_dns_cache_empty">暂未缓存 Steam DNS 记录</string>
    <string name="steam_network_dynamic_dns_cache_hint">缓存会自动过期；清空后，下次 Steam 请求会重新动态解析。</string>
    <string name="steam_network_dynamic_dns_cache_clear">清空缓存</string>
    <string name="steam_network_dynamic_dns_cache_refresh">强制刷新</string>
    <string name="steam_network_dynamic_dns_scope">覆盖 Steam 手机版常用 API 与服务子域，包括 steampowered.com、steamcommunity.com、steamstatic.com、steamusercontent.com、steam-chat.com 及已知 Steam CDN 域名族。</string>
    <string name="steam_network_resolver_live_summary">所有解析来源统一管理：既支持传统 DNS，也支持 HTTPS DoH。</string>
    <string name="steam_network_dynamic_dns_privacy">DNS / DoH 服务可以看到 Monica Steam 查询的公开 Steam 域名；账号凭据、Steam Guard 密钥、Cookie、令牌和聊天正文不会发送给解析服务。</string>
    <string name="steam_network_resolver_servers_title">解析服务器</string>
    <string name="steam_network_resolver_benchmark_all">全部测速</string>
    <string name="steam_network_resolver_benchmark_one">测速</string>
    <string name="steam_network_resolver_benchmark_running">测速中…</string>
    <string name="steam_network_resolver_benchmark_latency">%1$d 毫秒</string>
    <string name="steam_network_resolver_benchmark_partial">%1$d/%2$d 域名 · %3$d 毫秒</string>
    <string name="steam_network_resolver_benchmark_unavailable">不可用</string>
    <string name="steam_network_resolver_system_endpoint">Android 当前网络 DNS</string>
    <string name="steam_network_resolver_benchmark_hint">系统 DNS、内置 DoH 和自定义解析服务器都在这一页统一选择与测速；关闭的来源不会参与动态解析或完整扫描。</string>

    <string name="steam_network_custom_resolver_title">添加解析服务器</string>
    <string name="steam_network_custom_dns_unified_description">只需填写一个地址：以 https:// 开头时自动作为 DoH，否则作为普通 DNS。DoH 可选填 Bootstrap IP。</string>
    <string name="steam_network_custom_dns_address_label">服务器地址</string>
    <string name="steam_network_custom_dns_unified_placeholder">1.1.1.1 或 https://dns.example/dns-query</string>
    <string name="steam_network_custom_dns_address_hint">自动识别普通 DNS 与 DoH，不需要切换页面或类型。</string>
    <string name="steam_network_custom_dns_bootstrap_label">Bootstrap IP（可选，可多个）</string>
    <string name="steam_network_custom_dns_bootstrap_hint">仅 DoH 使用。可填写多个 IPv4 / IPv6，用于直接找到 DoH 服务器；HTTPS 仍按 URL 中的域名进行 SNI 与证书校验。</string>

    <string name="steam_network_custom_doh_bootstrap_placeholder">1.1.1.1, 1.0.0.1</string>
    <string name="steam_network_custom_doh_bootstrap_invalid">这里只能填写合法 IPv4 / IPv6；多个地址请用逗号或空格分隔。</string>
    <string name="steam_network_custom_doh_bootstrap_summary">引导 IP：%1$s</string>

    <string name="steam_network_ech_server_title">ECH 解析服务器</string>
    <string name="steam_network_ech_server_description">简单兼容模式：默认跟随当前 DNS，也可以单独选择已有 DoH 作为 ECH 配置查询来源。</string>
    <string name="steam_network_ech_dialog_title">选择 ECH 解析服务器</string>
    <string name="steam_network_ech_same_as_dns">与 DNS 相同</string>
    <string name="steam_network_ech_same_as_dns_description">跟随当前启用的 DNS / DoH 解析来源</string>
    <string name="steam_network_ech_choose">选择</string>
    <string name="steam_network_ech_done">完成</string>

    <string name="steam_network_ipv6_prefer">IPv6 优先</string>
    <string name="steam_network_ipv6_prefer_description">DoH / 系统解析同时获得 IPv4 与 IPv6 时优先尝试 IPv6；不可用时仍可回落 IPv4。传统自定义 DNS 当前仍查询 A 记录。</string>
    <string name="steam_network_dynamic_entry_title">动态 DNS</string>
    <string name="steam_network_dynamic_entry_enabled">实时动态解析已开启 · %1$d 个来源</string>
    <string name="steam_network_dynamic_entry_disabled">实时动态解析未开启 · 点击配置解析来源</string>
    <string name="steam_network_dynamic_entry_description">这是日常推荐模式：配置一次后自动解析，不固定 Steam IP，也不要求每次先扫描。</string>
    <string name="steam_network_static_hosts_title">静态 Hosts 扫描加速</string>
    <string name="steam_network_static_hosts_description">这是另一套独立机制：扫描并验证当前可用 IP 后写入应用内 Hosts。IP 被固定，网络环境变化后应重新扫描再应用。</string>
    <string name="steam_network_static_hosts_scan">扫描静态 Hosts</string>
    <string name="steam_network_static_hosts_rescan">重新扫描静态 Hosts</string>
    <string name="steam_network_static_hosts_apply">应用静态 Hosts</string>
    <string name="steam_network_static_hosts_disable">停用静态 Hosts</string>
</resources>
